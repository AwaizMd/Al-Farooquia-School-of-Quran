# Web app settings. Everything here ends up in the browser: never put secrets in this file.

# Where the browser calls the API. Leave unset to use the same origin (/api/v1), which is
# the recommended setup: Caddy serves the app and proxies /api to the backend.
# VITE_API_BASE_URL=https://api.example.org/api/v1

# Development only: where `npm run dev` forwards /api, and the dev server port.
# API_PROXY_TARGET=http://localhost:4000
# WEB_PORT=5173
