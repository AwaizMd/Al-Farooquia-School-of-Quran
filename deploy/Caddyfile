# Production web server: HTTPS (automatic certificates), the built web app,
# and the API on the same origin so session cookies stay first-party.
# Replace madarsa.example.org with the real domain.

madarsa.example.org {
	encode zstd gzip

	# The website's server reaches this directly; nobody outside may.
	handle /api/v1/public/* {
		respond 404
	}

	# API and gateway webhooks
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	# Single-page app: unknown paths serve index.html
	handle {
		root * /srv/madarsa/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# The kiosk page (/kiosk.html) reads QR codes with the camera; only this origin may use it.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# No third-party code; fonts come from Google Fonts.
		Content-Security-Policy "default-src 'self'; script-src 'self'; frame-src 'none'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Long cache for fingerprinted assets, none for the HTML shell.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html /kiosk.html /kiosk-sw.js /kiosk.webmanifest
	header @html Cache-Control "no-cache"
}

# One block per madrasa's public website. The hostname is what selects the madrasa; add the
# same hostname under Public Website > Settings. Next.js sets its own security headers.
www.madarsa.example.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3100
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
