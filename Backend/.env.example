# Copy to Backend/.env for local development. Never commit a real .env.
# Production: inject these from the host's secret store, not from a file in the repo.

# --- Application ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse proxies in front of the API (e.g. 1 behind Caddy/Nginx).
TRUST_PROXY=0
# Serve Swagger UI at /api/docs. Keep false in production unless protected.
API_DOCS_ENABLED=true

# --- Database ------------------------------------------------------------
# Local: `npm run db:start` serves this exact URL (embedded PostgreSQL 17).
# Production: a dedicated least-privilege role, TLS required (add ?sslmode=require).
DATABASE_URL=postgresql://madarsa:madarsa_local_only@127.0.0.1:54320/madarsa_dev

# --- Browser access ------------------------------------------------------
# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (links in emails point here).
APP_BASE_URL=http://localhost:5173

# --- Sessions and secrets ------------------------------------------------
# Must be true whenever the site is served over HTTPS (always in production).
COOKIE_SECURE=false
# Generate each key with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keys the hashes of session cookies, emailed links and recovery codes.
# Rotating it signs everyone out and invalidates outstanding links and codes.
TOKEN_HMAC_KEY=
# AES-256-GCM keys for authenticator secrets, as version:key pairs. To rotate:
# add a new version, set MFA_ACTIVE_KEY_VERSION to it, keep old versions until
# every secret has been re-encrypted. Store separately from database backups.
MFA_ENCRYPTION_KEYS=1:
MFA_ACTIVE_KEY_VERSION=1
# Name shown in the authenticator app.
MFA_ISSUER=Al Farooquia MMS

# --- Email ---------------------------------------------------------------
# file = write messages to Backend/.local/outbox (development). smtp = send.
MAIL_TRANSPORT=file
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Al Farooquia MMS <no-reply@example.org>

# --- Fee payments -----------------------------------------------------------
# There is no payment gateway. Each madrasa enters its own bank account and UPI QR code
# in the app (Fee Payment Settings); families pay the madrasa directly and the office
# verifies each payment. Nothing to configure here.

# --- File storage (payment proofs, UPI QR codes, attachments) ---------------
# local = files on this server's disk (one server only; back the folder up).
# s3 = any S3-compatible private bucket (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
STORAGE_DIR=storage
UPLOAD_MAX_MB=15
S3_BUCKET=
S3_REGION=auto
# e.g. https://<account>.r2.cloudflarestorage.com for Cloudflare R2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Shared secret between this API and the public website's server (public-website/.env). Generate with: openssl rand -base64 48
# Leave empty to keep the public API switched off.
PUBLIC_SITE_TOKEN=

# Local development only. Never set in production (the API refuses to start).
DEV_DISABLE_MFA=false
