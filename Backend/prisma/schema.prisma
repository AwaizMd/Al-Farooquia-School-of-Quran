// Al Farooquia School of Quran: Madarsa Management System
// Every schema change goes through `npm run db:migrate`; never edit applied migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Institution
// ---------------------------------------------------------------------------

/// Single-institution deployment: exactly one row, id = 1.
model InstitutionSettings {
  id              Int              @id @default(1)
  brandName       String
  shortName       String
  brandArabic     String
  tagline         String
  address         String
  phone           String
  email           String
  /// ISO 4217 code. Money is stored in minor units of this currency.
  currency        String           @db.Char(3)
  /// IANA timezone used to decide "today", due dates and job schedules.
  timezone        String
  /// 0 = Sunday … 6 = Saturday
  weeklyOff       Int              @db.SmallInt
  feeDueDay       Int              @db.SmallInt
  updatedAt       DateTime         @updatedAt
  paymentSettings PaymentSettings?

  @@map("institution_settings")
}

// ---------------------------------------------------------------------------
// Identity, sessions and MFA
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PRINCIPAL
  MENTOR
  STUDENT
  PARENT
  WARDEN
}

enum UserStatus {
  /// Created by an administrator; no password set yet.
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Lower-cased. Optional because young students may not have an email.
  email              String?    @unique
  emailVerifiedAt    DateTime?  @db.Timestamptz(3)
  /// Lower-cased sign-in name for accounts without email (student admission number).
  username           String?    @unique
  displayName        String
  phone              String?
  /// Argon2id. Null until the invite is accepted.
  passwordHash       String?
  passwordChangedAt  DateTime?  @db.Timestamptz(3)
  status             UserStatus @default(INVITED)
  locale             String     @default("en")
  /// Set by an MFA reset: sign-in is blocked until the recovery flow completes.
  mfaRecoveryPending Boolean    @default(false)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  roles             UserRole[]
  sessions          Session[]
  tokens            AuthToken[]
  mfaCredentials    MfaCredential[]
  recoveryCodes     RecoveryCode[]
  recoveryRequests  MfaRecoveryRequest[]     @relation("RecoveryFor")
  recoveryInitiated MfaRecoveryRequest[]     @relation("RecoveryInitiatedBy")
  staffProfile      StaffProfile?
  guardianProfile   Guardian?
  studentProfile    Student?
  notifications     Notification[]
  notificationPrefs NotificationPreference[]

  @@map("users")
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Which roles must use MFA. Editable by administrators; enforced on the server.
model MfaPolicy {
  role      Role     @id
  required  Boolean
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("mfa_policies")
}

enum SessionStage {
  /// Password verified; only MFA verification endpoints are reachable.
  PRE_MFA
  /// Password (or recovery link) verified; only MFA enrollment endpoints are reachable.
  MFA_ENROLLMENT
  FULL
}

model Session {
  id                String       @id @default(uuid()) @db.Uuid
  /// HMAC-SHA256 of the cookie token; the token itself is never stored.
  tokenHash         String       @unique
  csrfToken         String
  userId            String       @db.Uuid
  stage             SessionStage
  /// Recovery request this enrollment session belongs to, if any.
  recoveryRequestId String?      @db.Uuid
  failedMfaAttempts Int          @default(0)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime     @default(now()) @db.Timestamptz(3)
  idleTimeoutSec    Int
  absoluteExpiresAt DateTime     @db.Timestamptz(3)
  /// Last password(+MFA) confirmation, for sensitive actions.
  reauthenticatedAt DateTime?    @db.Timestamptz(3)
  revokedAt         DateTime?    @db.Timestamptz(3)
  revokedReason     String?
  ip                String?
  userAgent         String?
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

enum AuthTokenPurpose {
  INVITE
  PASSWORD_RESET
  MFA_RECOVERY
}

/// Single-use, short-lived tokens sent by email or handed over in person.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

enum MfaCredentialStatus {
  PENDING
  ACTIVE
  REVOKED
}

model MfaCredential {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @db.Uuid
  status           MfaCredentialStatus
  /// AES-256-GCM over the base32 TOTP secret, bound to (userId, id) as AAD.
  secretCiphertext Bytes
  secretIv         Bytes
  secretTag        Bytes
  keyVersion       Int
  /// Highest accepted TOTP time step; blocks code replay.
  lastUsedStep     BigInt?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  /// Pending enrollments are discarded after this time.
  expiresAt        DateTime?           @db.Timestamptz(3)
  activatedAt      DateTime?           @db.Timestamptz(3)
  revokedAt        DateTime?           @db.Timestamptz(3)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes    RecoveryCode[]

  // A partial unique index (one ACTIVE credential per user) is added in the migration SQL.
  @@index([userId, status])
  @@map("mfa_credentials")
}

model RecoveryCode {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  credentialId String        @db.Uuid
  codeHash     String        @unique
  usedAt       DateTime?     @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

enum RecoveryMethod {
  /// Single-use link to the user's verified email.
  EMAIL_LINK
  /// One-time ticket handed to the user after an in-person identity check.
  IN_PERSON
}

enum RecoveryStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model MfaRecoveryRequest {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  /// Null when started from the break-glass CLI.
  initiatedById String?        @db.Uuid
  reason        String
  method        RecoveryMethod
  status        RecoveryStatus @default(PENDING)
  tokenId       String         @unique @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?      @db.Timestamptz(3)
  user          User           @relation("RecoveryFor", fields: [userId], references: [id], onDelete: Cascade)
  initiatedBy   User?          @relation("RecoveryInitiatedBy", fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("mfa_recovery_requests")
}

/// Fixed-window counters for rate limiting, shared by every API instance.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(3)

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// People: groups (halqas), staff, guardians, students
// ---------------------------------------------------------------------------

enum Track {
  HIFZ
  NAZIRA
  QAIDA
  ALIM
}

enum Gender {
  MALE
  FEMALE
}

enum GroupGender {
  BOYS
  GIRLS
  MIXED
}

/// A halqa / class.
model Group {
  id        String      @id @default(uuid()) @db.Uuid
  /// Stable human-readable reference, e.g. "g-hifz-a".
  code      String      @unique
  name      String
  short     String
  track     Track
  room      String?
  timing    String?
  gender    GroupGender
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  students           Student[]
  mentors            GroupMentorAssignment[]
  enrollments        GroupEnrollment[]
  attendanceSessions AttendanceSession[]
  exams              ExamGroup[]

  @@map("groups")
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

/// Staff member (mentor, principal, warden). Optionally linked to a sign-in account.
model StaffProfile {
  id             String      @id @default(uuid()) @db.Uuid
  code           String      @unique
  userId         String?     @unique @db.Uuid
  displayName    String
  title          String
  phone          String?
  email          String?
  joinedOn       DateTime?   @db.Date
  status         StaffStatus @default(ACTIVE)
  qualification  String?
  specialisation String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  assignments     GroupMentorAssignment[]
  learningRecords LearningRecord[]
  examsExamined   Exam[]

  @@map("staff_profiles")
}

/// Who teaches a halqa, with history. One open (endedAt null) row per group,
/// enforced by a partial unique index in the migration.
model GroupMentorAssignment {
  id        String       @id @default(uuid()) @db.Uuid
  groupId   String       @db.Uuid
  staffId   String       @db.Uuid
  startedAt DateTime     @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?    @db.Timestamptz(3)
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId, endedAt])
  @@index([groupId, endedAt])
  @@map("group_mentor_assignments")
}

model Guardian {
  id         String            @id @default(uuid()) @db.Uuid
  code       String            @unique
  userId     String?           @unique @db.Uuid
  name       String
  relation   String
  phone      String
  email      String?
  occupation String?
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students   StudentGuardian[]

  @@index([phone])
  @@map("guardians")
}

enum StudentStatus {
  ACTIVE
  /// Left or on extended leave; history is kept.
  INACTIVE
}

model Student {
  id              String                    @id @default(uuid()) @db.Uuid
  /// Institution-assigned, unique, never reused. Also the student's sign-in name.
  admissionNo     String                    @unique
  userId          String?                   @unique @db.Uuid
  name            String
  gender          Gender
  dob             DateTime                  @db.Date
  admissionDate   DateTime                  @db.Date
  status          StudentStatus             @default(ACTIVE)
  groupId         String                    @db.Uuid
  phone           String
  address         String?
  hostelResident  Boolean                   @default(false)
  bloodGroup      String?
  medicalNotes    String?
  feePlanId       String?                   @db.Uuid
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  user            User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  group           Group                     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  feePlan         FeePlan?                  @relation(fields: [feePlanId], references: [id], onDelete: Restrict)
  guardians       StudentGuardian[]
  enrollments     GroupEnrollment[]
  concessions     Concession[]
  attendance      AttendanceRecord[]
  learningRecords LearningRecord[]
  examResults     ExamResult[]
  invoices        Invoice[]
  payments        Payment[]
  paymentAttempts PaymentAttempt[]
  manualPayments  ManualPaymentSubmission[]
  bedAssignments  BedAssignment[]
  hostelRoll      HostelRollEntry[]

  @@index([groupId, status])
  @@index([name])
  @@map("students")
}

model StudentGuardian {
  studentId             String   @db.Uuid
  guardianId            String   @db.Uuid
  isPrimary             Boolean  @default(false)
  canViewFees           Boolean  @default(true)
  canPay                Boolean  @default(true)
  receivesNotifications Boolean  @default(true)
  linkedAt              DateTime @default(now()) @db.Timestamptz(3)
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian              Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

/// Group membership history (current = endedOn null).
model GroupEnrollment {
  id        String    @id @default(uuid()) @db.Uuid
  studentId String    @db.Uuid
  groupId   String    @db.Uuid
  startedOn DateTime  @db.Date
  endedOn   DateTime? @db.Date
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@map("group_enrollments")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

/// One register per halqa per day. A day with no session has simply not been marked yet.
model AttendanceSession {
  id         String             @id @default(uuid()) @db.Uuid
  groupId    String             @db.Uuid
  date       DateTime           @db.Date
  markedById String?            @db.Uuid
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)
  group      Group              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  records    AttendanceRecord[]

  @@unique([groupId, date])
  @@index([date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String                 @id @default(uuid()) @db.Uuid
  sessionId   String                 @db.Uuid
  studentId   String                 @db.Uuid
  /// Copied from the session so a student can never be marked twice on one day.
  date        DateTime               @db.Date
  status      AttendanceStatus
  note        String?
  markedById  String?                @db.Uuid
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  session     AttendanceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  corrections AttendanceCorrection[]

  @@unique([studentId, date])
  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

/// Every change to a saved status, with who, when and (after the day) why.
model AttendanceCorrection {
  id            String           @id @default(uuid()) @db.Uuid
  recordId      String           @db.Uuid
  fromStatus    AttendanceStatus
  toStatus      AttendanceStatus
  reason        String?
  correctedById String?          @db.Uuid
  at            DateTime         @default(now()) @db.Timestamptz(3)
  record        AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("attendance_corrections")
}

// ---------------------------------------------------------------------------
// Learning progress (Sabaq, Sabqi, Manzil, Nazira, Qaida)
// ---------------------------------------------------------------------------

enum LearningCategory {
  SABAQ
  SABQI
  MANZIL
  NAZIRA
  QAIDA
}

enum TajweedQuality {
  GOOD
  FAIR
  WEAK
}

enum RevisionDone {
  DONE
  PARTIAL
  NOT
}

enum TargetStatus {
  MET
  PARTIAL
  MISSED
}

/// One lesson assessment. Records are never overwritten: edits keep a revision.
model LearningRecord {
  id              String                   @id @default(uuid()) @db.Uuid
  studentId       String                   @db.Uuid
  /// Mentor who taught the lesson (null if recorded by administration).
  mentorId        String?                  @db.Uuid
  recordedById    String?                  @db.Uuid
  date            DateTime                 @db.Date
  category        LearningCategory
  surah           Int?                     @db.SmallInt
  fromAyah        Int?                     @db.SmallInt
  toAyah          Int?                     @db.SmallInt
  juz             Int?                     @db.SmallInt
  qaidaLesson     Int?                     @db.SmallInt
  /// 1 (needs a lot of support) … 5 (excellent)
  performance     Int                      @db.SmallInt
  mistakes        Int                      @db.SmallInt
  fluency         Int                      @db.SmallInt
  tajweed         TajweedQuality
  prevRevision    RevisionDone
  revisionQuality Int?                     @db.SmallInt
  targetStatus    TargetStatus
  comments        String
  nextTarget      String
  followUp        Boolean                  @default(false)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  student         Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor          StaffProfile?            @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  revisions       LearningRecordRevision[]

  @@index([studentId, date(sort: Desc)])
  @@index([date])
  @@map("learning_records")
}

model LearningRecordRevision {
  id         String         @id @default(uuid()) @db.Uuid
  recordId   String         @db.Uuid
  /// The record as it was before this edit.
  previous   Json
  reason     String?
  editedById String?        @db.Uuid
  at         DateTime       @default(now()) @db.Timestamptz(3)
  record     LearningRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("learning_record_revisions")
}

// ---------------------------------------------------------------------------
// Assessments: grading scales, exams, marks
// ---------------------------------------------------------------------------

/// Versioned grading scale. Editing creates a new version; published exams
/// keep the version they were graded with.
model GradingScale {
  id          String      @id @default(uuid()) @db.Uuid
  version     Int         @unique
  active      Boolean     @default(false)
  createdById String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  bands       GradeBand[]
  exams       Exam[]

  @@map("grading_scales")
}

model GradeBand {
  id         String       @id @default(uuid()) @db.Uuid
  scaleId    String       @db.Uuid
  grade      String
  arabic     String?
  minPercent Int          @db.SmallInt
  meaning    String?
  scale      GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, minPercent])
  @@map("grade_bands")
}

enum ExamStatus {
  SCHEDULED
  /// Results visible to students and guardians.
  PUBLISHED
  CANCELLED
}

model Exam {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  title          String
  type           String
  track          Track
  date           DateTime      @db.Date
  examinerId     String?       @db.Uuid
  status         ExamStatus    @default(SCHEDULED)
  /// Set when published; results are graded with this scale from then on.
  gradingScaleId String?       @db.Uuid
  publishedAt    DateTime?     @db.Timestamptz(3)
  publishedById  String?       @db.Uuid
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  examiner       StaffProfile? @relation(fields: [examinerId], references: [id], onDelete: SetNull)
  gradingScale   GradingScale? @relation(fields: [gradingScaleId], references: [id], onDelete: Restrict)
  groups         ExamGroup[]
  subjects       ExamSubject[]
  results        ExamResult[]

  @@index([date])
  @@map("exams")
}

model ExamGroup {
  examId  String @db.Uuid
  groupId String @db.Uuid
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([examId, groupId])
  @@map("exam_groups")
}

model ExamSubject {
  id       String     @id @default(uuid()) @db.Uuid
  examId   String     @db.Uuid
  name     String
  maxMarks Int        @db.SmallInt
  position Int        @db.SmallInt
  exam     Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  marks    ExamMark[]

  @@unique([examId, name])
  @@map("exam_subjects")
}

model ExamResult {
  id          String     @id @default(uuid()) @db.Uuid
  examId      String     @db.Uuid
  studentId   String     @db.Uuid
  absent      Boolean    @default(false)
  remark      String?
  enteredById String?    @db.Uuid
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks       ExamMark[]

  @@unique([examId, studentId])
  @@map("exam_results")
}

model ExamMark {
  resultId  String      @db.Uuid
  subjectId String      @db.Uuid
  marks     Int         @db.SmallInt
  result    ExamResult  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject   ExamSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([resultId, subjectId])
  @@map("exam_marks")
}

// ---------------------------------------------------------------------------
// Fee plans and concessions (billing itself arrives with the fees module)
// ---------------------------------------------------------------------------

model FeePlan {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  /// Minor units (paise for INR).
  amountMinor Int
  currency    String    @db.Char(3)
  cycle       String    @default("MONTHLY")
  covers      String?
  active      Boolean   @default(true)
  students    Student[]
  invoices    Invoice[]

  @@map("fee_plans")
}

enum ConcessionKind {
  SIBLING
  NEED_BASED
  FULL_SPONSORSHIP
}

enum InvoiceStatus {
  ISSUED
  /// Cancelled before any payment; kept for the record.
  VOID
}

/// A fee assessed for one billing period. Amounts are copied from the plan and
/// concession when issued, so later plan changes never alter it.
model Invoice {
  id            String              @id @default(uuid()) @db.Uuid
  number        String              @unique
  studentId     String              @db.Uuid
  /// YYYY-MM
  period        String              @db.Char(7)
  planId        String              @db.Uuid
  currency      String              @db.Char(3)
  grossMinor    Int
  discountMinor Int
  amountMinor   Int
  issuedOn      DateTime            @db.Date
  dueDate       DateTime            @db.Date
  status        InvoiceStatus       @default(ISSUED)
  voidReason    String?
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  student       Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan          FeePlan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  allocations   PaymentAllocation[]
  adjustments   FeeAdjustment[]
  refundParts   RefundAllocation[]

  @@unique([studentId, period, planId])
  @@index([studentId, status])
  @@index([dueDate])
  @@map("invoices")
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum PaymentSource {
  MANUAL
  ONLINE
  /// A bank transfer or UPI payment the payer reported and staff verified.
  VERIFIED
}

/// Money received. Confirmed payments are never edited; refunds reverse them.
model Payment {
  id               String                   @id @default(uuid()) @db.Uuid
  studentId        String                   @db.Uuid
  receiptId        String                   @unique @db.Uuid
  amountMinor      Int
  /// Received but not matched to an open invoice (needs review).
  unallocatedMinor Int                      @default(0)
  currency         String                   @db.Char(3)
  method           PaymentMethod
  source           PaymentSource
  receivedOn       DateTime                 @db.Date
  recordedById     String?                  @db.Uuid
  note             String?
  paymentAttemptId String?                  @unique @db.Uuid
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  student          Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  receipt          Receipt                  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  attempt          PaymentAttempt?          @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  allocations      PaymentAllocation[]
  refunds          Refund[]
  /// UTR / bank reference or gateway payment id, shown on the receipt.
  reference        String?
  manualSubmission ManualPaymentSubmission?

  @@index([studentId])
  @@index([receivedOn])
  @@map("payments")
}

model PaymentAllocation {
  paymentId   String  @db.Uuid
  invoiceId   String  @db.Uuid
  amountMinor Int
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@id([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model Receipt {
  id       String   @id @default(uuid()) @db.Uuid
  /// NR-<financial year start>-<sequence>, gapless within each April–March year.
  number   String   @unique
  issuedAt DateTime @default(now()) @db.Timestamptz(3)
  payment  Payment?

  @@map("receipts")
}

model ReceiptSequence {
  /// Financial year start, e.g. 2026 for April 2026 – March 2027.
  fiscalYear Int @id
  last       Int

  @@map("receipt_sequences")
}

enum AdjustmentKind {
  WAIVER
  CORRECTION
}

/// Approved reduction of an invoice's amount due (positive = less to pay).
model FeeAdjustment {
  id           String         @id @default(uuid()) @db.Uuid
  invoiceId    String         @db.Uuid
  kind         AdjustmentKind
  amountMinor  Int
  reason       String
  approvedById String?        @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("fee_adjustments")
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

model Refund {
  id          String             @id @default(uuid()) @db.Uuid
  paymentId   String             @db.Uuid
  amountMinor Int
  reason      String
  status      RefundStatus
  providerRef String?
  createdById String?            @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  payment     Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  allocations RefundAllocation[]

  @@index([paymentId])
  @@map("refunds")
}

/// Which invoice a refund gives back to (the balance due rises again).
model RefundAllocation {
  refundId    String  @db.Uuid
  invoiceId   String  @db.Uuid
  amountMinor Int
  refund      Refund  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@id([refundId, invoiceId])
  @@map("refund_allocations")
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

/// An online checkout. Only a verified provider event can mark it SUCCEEDED.
model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  reference         String               @unique
  studentId         String               @db.Uuid
  payerUserId       String               @db.Uuid
  invoiceIds        String[]             @db.Uuid
  amountMinor       Int
  currency          String               @db.Char(3)
  provider          String
  providerOrderId   String?              @unique
  providerPaymentId String?
  status            PaymentAttemptStatus @default(CREATED)
  failureReason     String?
  expiresAt         DateTime             @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payment           Payment?

  @@index([studentId, status])
  @@map("payment_attempts")
}

/// Every provider callback, stored once. The unique key makes replays no-ops.
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  eventId        String
  type           String
  signatureValid Boolean
  /// Provider payload with card/bank details removed.
  payload        Json
  receivedAt     DateTime  @default(now()) @db.Timestamptz(3)
  processedAt    DateTime? @db.Timestamptz(3)
  result         String?

  @@unique([provider, eventId])
  @@map("webhook_events")
}

/// Approved fee concession. One open row per student (partial unique index).
model Concession {
  id           String         @id @default(uuid()) @db.Uuid
  studentId    String         @db.Uuid
  kind         ConcessionKind
  percent      Int            @db.SmallInt
  approvedById String?        @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  endedAt      DateTime?      @db.Timestamptz(3)
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("concessions")
}

// ---------------------------------------------------------------------------
// Hostel
// ---------------------------------------------------------------------------

model HostelRoom {
  id     String      @id @default(uuid()) @db.Uuid
  code   String      @unique
  block  String
  floor  String
  active Boolean     @default(true)
  beds   HostelBed[]

  @@map("hostel_rooms")
}

model HostelBed {
  id          String          @id @default(uuid()) @db.Uuid
  roomId      String          @db.Uuid
  label       String
  active      Boolean         @default(true)
  room        HostelRoom      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignments BedAssignment[]

  @@unique([roomId, label])
  @@map("hostel_beds")
}

/// Who sleeps where, with history. Partial unique indexes (migration) allow one
/// open assignment per bed and per student, so a bed can never be double-booked.
model BedAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  bedId        String    @db.Uuid
  studentId    String    @db.Uuid
  startedAt    DateTime  @default(now()) @db.Timestamptz(3)
  endedAt      DateTime? @db.Timestamptz(3)
  assignedById String?   @db.Uuid
  endReason    String?
  bed          HostelBed @relation(fields: [bedId], references: [id], onDelete: Restrict)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([bedId])
  @@map("bed_assignments")
}

enum HostelRollStatus {
  PRESENT
  ABSENT
  LEAVE
}

/// Night roll call: one mark per resident per date.
model HostelRollEntry {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @db.Uuid
  date       DateTime         @db.Date
  status     HostelRollStatus
  note       String?
  markedById String?          @db.Uuid
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
  @@map("hostel_roll_entries")
}

// ---------------------------------------------------------------------------
// Digital library
// ---------------------------------------------------------------------------

enum LibraryAudience {
  ALL_STUDENTS
  HIFZ
  ALIM
  STAFF_ONLY
}

enum ResourceStatus {
  ACTIVE
  ARCHIVED
}

model LibraryResource {
  id           String          @id @default(uuid()) @db.Uuid
  title        String
  category     String
  type         String
  author       String?
  description  String?
  pages        Int?            @db.SmallInt
  audience     LibraryAudience @default(ALL_STUDENTS)
  status       ResourceStatus  @default(ACTIVE)
  fileId       String?         @unique @db.Uuid
  uploadedById String?         @db.Uuid
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  file         StoredFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([status, category])
  @@map("library_resources")
}

/// File metadata. The bytes live in private storage under `storageKey` (never the uploaded name).
model StoredFile {
  id           String                   @id @default(uuid()) @db.Uuid
  storageKey   String                   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedById String?                  @db.Uuid
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  resource     LibraryResource?
  /// What the file is for, so a library file can never be passed off as payment proof.
  purpose      FilePurpose              @default(LIBRARY)
  upiQrFor     PaymentSettings?
  proofFor     ManualPaymentSubmission?

  @@map("stored_files")
}

// ---------------------------------------------------------------------------
// Notifications, reminders, scheduled reports, job status
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationCategory {
  FEES
  PROGRESS
  ATTENDANCE
  RESULTS
  GENERAL
}

/// In-app notification for one signed-in account.
model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  title     String
  body      String
  link      String?
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  readAt    DateTime?            @db.Timestamptz(3)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Opt-outs (in-app and email default on) and opt-ins with consent (WhatsApp, SMS).
model NotificationPreference {
  userId    String               @db.Uuid
  channel   NotificationChannel
  category  NotificationCategory
  enabled   Boolean
  consentAt DateTime?            @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @db.Timestamptz(3)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel, category])
  @@map("notification_preferences")
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  /// Deliberately not sent (no consent, channel not configured, no longer relevant).
  SKIPPED
}

/// One outbound message. `dedupeKey` makes every scheduled message unique.
model NotificationDelivery {
  id                String               @id @default(uuid()) @db.Uuid
  dedupeKey         String               @unique
  userId            String?              @db.Uuid
  guardianId        String?              @db.Uuid
  channel           NotificationChannel
  category          NotificationCategory
  recipient         String?
  subject           String
  body              String
  /// Re-checked just before sending (e.g. an invoice that must still be unpaid).
  invoiceId         String?              @db.Uuid
  status            DeliveryStatus       @default(QUEUED)
  attempts          Int                  @default(0)
  lastError         String?
  providerMessageId String?
  nextAttemptAt     DateTime             @default(now()) @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  sentAt            DateTime?            @db.Timestamptz(3)
  reportRunId       String?              @db.Uuid
  reportRun         ReportRun?           @relation(fields: [reportRunId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([invoiceId])
  @@map("notification_deliveries")
}

/// When fee reminders go out, relative to the due date.
model ReminderRule {
  key        String                @id
  label      String
  offsetDays Int                   @db.SmallInt
  enabled    Boolean               @default(true)
  channels   NotificationChannel[]
  position   Int                   @db.SmallInt
  updatedAt  DateTime              @updatedAt @db.Timestamptz(3)

  @@map("reminder_rules")
}

model MessageTemplate {
  key       String   @id
  subject   String
  body      String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("message_templates")
}

enum ReportFrequency {
  WEEKLY
  MONTHLY
}

/// Parent progress report schedule (single row, id = 1).
model ScheduledReportConfig {
  id         Int                   @id @default(1)
  enabled    Boolean               @default(true)
  frequency  ReportFrequency       @default(MONTHLY)
  /// 0 = Sunday … 6 = Saturday (weekly reports)
  dayOfWeek  Int                   @default(6) @db.SmallInt
  /// 1–28 (monthly reports)
  dayOfMonth Int                   @default(1) @db.SmallInt
  /// HH:MM in the institution's timezone
  sendAt     String                @default("09:00")
  channels   NotificationChannel[] @default([EMAIL, IN_APP])
  sections   String[]              @default(["attendance", "learning", "assessments", "feedback"])
  updatedAt  DateTime              @updatedAt @db.Timestamptz(3)

  @@map("scheduled_report_config")
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One execution of the parent report for one period; the unique key makes reruns no-ops.
model ReportRun {
  id          String                 @id @default(uuid()) @db.Uuid
  periodKey   String                 @unique
  periodStart DateTime               @db.Date
  periodEnd   DateTime               @db.Date
  status      RunStatus              @default(RUNNING)
  startedAt   DateTime               @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime?              @db.Timestamptz(3)
  stats       Json?
  error       String?
  deliveries  NotificationDelivery[]

  @@map("report_runs")
}

/// Last run of each background job, for monitoring.
model JobStatus {
  name            String    @id
  lastStartedAt   DateTime? @db.Timestamptz(3)
  lastSucceededAt DateTime? @db.Timestamptz(3)
  lastFailedAt    DateTime? @db.Timestamptz(3)
  lastError       String?
  lastResult      Json?

  @@map("job_status")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. In production the application role has no UPDATE/DELETE grant.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(3)
  /// Null for system/job actions.
  actorUserId String?  @db.Uuid
  actorName   String
  actorRole   String
  action      String
  entityType  String?
  entityId    String?
  summary     String
  /// Extra structured context. Must never contain secrets, tokens or codes.
  metadata    Json?
  ip          String?
  requestId   String?

  @@index([at(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, at(sort: Desc)])
  @@map("audit_logs")
}

// ---------- Configurable payment methods ----------

enum FilePurpose {
  LIBRARY
  PAYMENT_PROOF
  UPI_QR
}

enum RazorpayMode {
  TEST
  LIVE
}

/// How the institution accepts fees: Razorpay, bank transfer and/or UPI QR.
/// Razorpay secrets are AES-256-GCM sealed (SETTINGS_ENCRYPTION_KEYS); never returned by the API.
model PaymentSettings {
  institutionId                Int                 @id @default(1)
  razorpayEnabled              Boolean             @default(false)
  razorpayMode                 RazorpayMode        @default(TEST)
  razorpayKeyId                String?
  razorpaySecret               Bytes?
  razorpayWebhookSecret        Bytes?
  /// When the current keys were last checked against Razorpay's API.
  razorpayValidatedAt          DateTime?           @db.Timestamptz(3)
  /// Key id for which a correctly signed webhook last arrived (live readiness needs one).
  razorpayWebhookVerifiedKeyId String?
  razorpayWebhookVerifiedAt    DateTime?           @db.Timestamptz(3)
  bankEnabled                  Boolean             @default(false)
  bankAccountName              String?
  bankName                     String?
  bankAccountNumber            String?
  bankIfsc                     String?
  bankBranch                   String?
  bankAccountType              String?
  bankInstructions             String?
  bankReferenceHint            String?
  bankProofRequired            Boolean             @default(false)
  upiEnabled                   Boolean             @default(false)
  upiQrFileId                  String?             @unique @db.Uuid
  upiId                        String?
  upiPayeeName                 String?
  upiInstructions              String?
  upiProofRequired             Boolean             @default(false)
  updatedById                  String?             @db.Uuid
  updatedAt                    DateTime            @updatedAt @db.Timestamptz(3)
  institution                  InstitutionSettings @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  upiQr                        StoredFile?         @relation(fields: [upiQrFileId], references: [id], onDelete: Restrict)

  @@map("payment_settings")
}

enum ManualPaymentMethod {
  BANK_TRANSFER
  UPI
}

enum ManualPaymentStatus {
  PENDING_VERIFICATION
  NEEDS_INFO
  APPROVED
  REJECTED
}

/// A payer's claim that they paid by bank transfer or UPI. It changes no balance
/// until authorised staff approve it, which records a Payment in the one ledger.
model ManualPaymentSubmission {
  id                  String              @id @default(uuid()) @db.Uuid
  studentId           String              @db.Uuid
  submittedById       String              @db.Uuid
  method              ManualPaymentMethod
  /// Invoices the payer says this covers (empty = oldest due first).
  invoiceIds          String[]            @db.Uuid
  amountMinor         Int
  currency            String              @db.Char(3)
  paidOn              DateTime            @db.Date
  /// UTR / transaction reference as typed, and normalised (A–Z, 0–9) for duplicate checks.
  reference           String
  referenceKey        String
  note                String?
  proofFileId         String?             @unique @db.Uuid
  status              ManualPaymentStatus @default(PENDING_VERIFICATION)
  reviewedById        String?             @db.Uuid
  reviewedAt          DateTime?           @db.Timestamptz(3)
  /// Rejection reason or the information requested.
  reviewNote          String?
  approvedAmountMinor Int?
  paymentId           String?             @unique @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  student             Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  proof               StoredFile?         @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  payment             Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([studentId])
  @@index([referenceKey])
  @@map("manual_payment_submissions")
}
